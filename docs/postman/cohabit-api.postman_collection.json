            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cosy studio near the mall\",\n  \"description\": \"Bright studio, water included\",\n  \"typeId\": \"{{listingTypeStudio}}\",\n  \"price\": 9200,\n  \"deposit\": 9200,\n  \"beds\": 1,\n  \"baths\": 1,\n  \"availableFrom\": \"2026-11-01\",\n  \"responseTime\": \"Within the hour\",\n  \"addressLine1\": \"12 Oxford Street\",\n  \"addressLine2\": \"Shop 3\",\n  \"suburb\": \"Rosebank\",\n  \"postalCode\": \"2196\",\n  \"provinceId\": \"{{provinceGauteng}}\",\n  \"amenityIds\": [{{amenityWifi}}, {{amenityParking}}],\n  \"ruleIds\": [{{ruleNoSmoking}}]\n}",
              "options": {

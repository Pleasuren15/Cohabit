          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Thabo\",\n  \"lastName\": \"Mokoena\",\n  \"cellphone\": \"0825551234\",\n  \"email\": \"thabo.mokoena@example.com\",\n  \"dateOfBirth\": \"1994-06-12\",\n  \"gender\": \"M\",\n  \"bio\": \"Looking for a flatmate in Cape Town\",\n  \"addressId\": \"{{addressId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a user. Captures the new user id into the environment as `userId`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const _v = pm.response.json();",
                  "    if (_v && _v.id) pm.environment.set('userId', _v.id);",
                  "}",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const _v = pm.response.json();",
                  "    if (_v && _v.addressId) pm.environment.set('addressId', _v.addressId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          },
          "response": []
        },
        {
          "name": "List user's listings",
          "request": {
            "method": "GET",

    {
      "name": "Comms API",
      "item": [
        {
          "name": "OTP",
          "item": [
            {
              "name": "Request OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": "{{commsBaseUrl}}/api/otp/request",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"channel\": \"Sms\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Dispatches an OTP to the JWT user via the selected channel (`Sms` | `Email`). The destination is resolved from the token's `phone_number`/`email` claim. Rate-limited to 2 requests per user per 15 minutes (429 on the 3rd). Requires a valid Bearer token in the `token` environment variable."
              },
              "response": []
            },
            {
              "name": "Verify OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  }
                ],
                "url": "{{commsBaseUrl}}/api/otp/verify",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"channel\": \"Sms\",\n  \"code\": \"123456\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Verifies a received OTP for the JWT user. A correct code is consumed (one-time use, so it verifies at most once). Returns 200 with `isValid: true/false`; a malformed code returns 400. Requires a valid Bearer token in the `token` environment variable."
              },
              "response": []
            }
          ]
        }
      ]
    }

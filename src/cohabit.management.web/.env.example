# Origin of the Cohabit API, e.g. http://localhost:5001.
# When running through Aspire this is injected automatically.
# Leave unset to call the same origin via the Vite dev proxy (vite.config.ts).
# VITE_API_URL=http://localhost:5001

# Supabase project credentials used for authentication (login/register).
# Find these in the Supabase dashboard under Project Settings -> API.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

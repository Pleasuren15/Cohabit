# Origin of the Cohabit API, e.g. http://localhost:5001.
# When running through Aspire this is injected automatically.
# Leave unset to call the same origin via the Vite dev proxy (vite.config.ts).
# VITE_API_URL=http://localhost:5001

# Set to "true" to use the bundled mock dataset (FEATURED_PROFILES) instead of
# the live API. Leave unset/false to hit the real API.
# VITE_USE_MOCK_DATA=false
